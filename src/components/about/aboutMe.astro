---
import MyPhoto from "../../assets/img/grandivPhoto.jpg";
import { siteContent } from "../../data/contentData";

const { about } = siteContent;
---

<!-- Main container -->
<div
  class="mx-auto mt-20 flex max-w-6xl flex-col items-center gap-8 px-6 lg:flex-row "
>
  <!-- Image -->
  <div
    class="border-primary h-64 w-64 overflow-hidden rounded-2xl shadow-lg md:h-96 md:w-96 drop-shadow-[4px_4px_0_#7836cf]"
  >
    <img
      src={MyPhoto.src}
      alt={about.photoAlt}
      class="h-full w-full object-cover"
    />
  </div>

  <!-- Text -->
  <div class="flex-1 text-center text-gray-300 lg:text-left">
    <h2 class="text-3xl font-bold text-white">
      My name is <span class="text-white text-shadow">{about.name}</span>
    </h2>
    <p class="mt-4">
      I'm from <span class="text-primary font-semibold">{about.location}</span> and currently
      working as a
      <span class="text-primary font-semibold">{about.role}</span>, with a focus on {about.focus.map((f, i) => (
        <><span class="text-primary font-semibold">{f}</span>{i < about.focus.length - 1 ? " and " : ""}</>
      ))},
      using technologies like <span class="text-primary italic">
        {about.technologies.join(", ")}
      </span>.
    </p>
    {
      about.bio.map((paragraph) => (
        <p class="mt-2" set:html={paragraph} />
      ))
    }
  </div>
</div>
