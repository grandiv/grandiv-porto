---
import { HiArrowRight } from "react-icons/hi";
import MyPhoto from "../../../assets/img/grandivPhoto.jpg";
import { siteContent } from "../../../data/contentData";

const { about } = siteContent;
---

<section class="relative flex items-center justify-center px-4 pt-16">
  <div
    class="absolute inset-0 -z-10 mx-auto max-w-6xl blur-3xl"
    aria-hidden="true"
  >
    <div class="h-112.5 w-full rounded-full bg-[#7836cf]/5"></div>
  </div>

  <div
    class="mx-auto flex max-w-4xl flex-col-reverse items-stretch gap-6 md:flex-row"
  >
    <div
      class="bg-base-900 border-none flex w-full items-center justify-center overflow-hidden rounded-2xl border p-0 shadow-lg md:w-1/3 drop-shadow-[4px_4px_0_#7836cf]"
    >
      <img
        src={MyPhoto.src}
        alt={about.photoAlt}
        class="h-full w-full object-cover"
      />
    </div>

    <div
      class="bg-gray-900 border-none flex w-full flex-col justify-center rounded-2xl border p-6 shadow-lg md:w-2/3 drop-shadow-[4px_4px_0_#7836cf]"
    >
      <h2 class="text-white text-4xl font-bold drop-shadow-[2px_2px_0_#7836cf]">
        About Me
      </h2>
      <p class="mt-2 font-semibold">
        My name is Grandiv, I'm a Software Engineer specializing in building scalable,
        production-ready systems. Currently architecting microservices platforms as a
        Backend Engineer while pursuing my B.S. in Information Technology at Gadjah Mada
        University. I excel in full-stack development, DevOps, and distributed systems,
        working with technologies like Go, Node.js, React, TypeScript, PostgreSQL, MongoDB,
        Docker, and Kubernetes. I'm passionate about creating robust solutions that solve
        real-world problems through clean architecture and innovative engineering.
      </p>

      <a
        href="/about"
        class="group mt-4 inline-flex items-center text-primary font-bold transition-all"
      >
        Learn more about me
        <HiArrowRight
          className="ml-1 transition-transform duration-200 group-hover:translate-x-1"
          size={18}
        />
      </a>
    </div>
  </div>
</section>
