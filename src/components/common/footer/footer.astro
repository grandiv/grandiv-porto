---
import SocialIcons from "../social/SocialIcons.jsx";
import { siteContent } from "../../../data/contentData";

const { navigation, footer } = siteContent;

// Build-time date — reflects when the site was last edited/deployed.
const lastUpdated = new Date().toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<footer class="bg-gray-950 text-white">
  <div
    class="container mx-auto flex flex-col items-center justify-between px-6 py-12 lg:flex-row lg:px-20"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center">
      <h3
        class="text-[#69c7c7] text-4xl font-bold drop-shadow-[1.5px_1.5px_0_#7836cf]"
      >
        {navigation.logo}
      </h3>
    </a>

    <!-- Navigation Links -->
    <nav class="mb-4 lg:mb-0">
      <ul
        class="flex flex-col items-center space-y-2 text-gray-400 lg:flex-row lg:items-start lg:space-y-0 lg:space-x-6"
      >
        {
          navigation.links.map((link) => (
            <li>
              <a href={link.href} class="hover:text-[#552496] font-semibold">
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Social Media Links -->
    <div class="flex space-x-4 ">
      <SocialIcons client:visible />
    </div>
  </div>

  <!-- Copyright -->
  <div
    class="flex w-full flex-col items-center gap-1 border-t border-gray-600 py-10 text-center text-sm text-gray-500"
  >
    <span>{footer.copyright}</span>
    <span class="text-xs text-gray-400">Last updated {lastUpdated}</span>
  </div>
</footer>
