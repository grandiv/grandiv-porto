# Normalize all text files to LF in the repo to stop CRLF/LF churn
# (e.g. from syncing between Windows and macOS).
* text=auto eol=lf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text eol=lf
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
